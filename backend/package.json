{
  "name": "enclave-backend",
  "version": "1.0.0",
  "description": "Zero-knowledge encrypted relay, WebRTC signaling, and anonymous relationship backend for Enclave",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/db/migrations',{recursive:true});fs.copyFileSync('src/db/migrations/001_init.sql','dist/db/migrations/001_init.sql');\"",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "test": "npx tsx --test tests/security_and_relay.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
